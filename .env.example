# Copie para .env / user-secrets — não commitar valores reais.

# Database: Sqlite (dev) ou SqlServer
Database__Provider=Sqlite
ConnectionStrings__Default=Data Source=App_Data/gistm.db
# ConnectionStrings__Default=Server=localhost,1433;Database=GistmCompass;User Id=sa;Password=Your_password123;TrustServerCertificate=True
# Database__Provider=SqlServer

# Object storage
Storage__Provider=Local
Storage__LocalRoot=App_Data/uploads
# Storage__Provider=Azure
# Storage__Azure__ConnectionString=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Storage__Azure__Container=gistm

# Job queue
Queue__Provider=InMemory
# Queue__Provider=Azure
# Queue__Azure__ConnectionString=...
# Queue__Azure__QueueName=gistm-jobs

# Optional Anthropic
Anthropic__ApiKey=
Anthropic__Model=claude-sonnet-4-20250514

# Optional Entra ID SSO
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=
AzureAd__ClientId=
AzureAd__ClientSecret=
AzureAd__CallbackPath=/signin-oidc
