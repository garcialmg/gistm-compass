@page "/cadastro"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav

<PageTitle>Criar organização — GISTM Compass</PageTitle>

<div class="auth-panel">
    <h1>Criar organização</h1>
    <p class="muted">Cadastre sua empresa e o usuário administrador.</p>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert">@Error</div>
    }

    <form method="post" action="/account/register" data-enhance="false">
        <div class="field">
            <label>Nome da organização</label>
            <input name="orgName" class="form-control" required />
        </div>
        <div class="field">
            <label>Seu nome</label>
            <input name="name" class="form-control" required />
        </div>
        <div class="field">
            <label>Email</label>
            <input name="email" type="email" class="form-control" required autocomplete="username" />
        </div>
        <div class="field">
            <label>Senha</label>
            <input name="password" type="password" class="form-control" required autocomplete="new-password" minlength="8" />
        </div>
        <button type="submit" class="btn btn-primary">Criar organização</button>
    </form>
    <p class="mt"><a href="login">Já tenho conta</a></p>
</div>

@code {
    private string? Error;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var err))
            Error = err.ToString();
    }
}
