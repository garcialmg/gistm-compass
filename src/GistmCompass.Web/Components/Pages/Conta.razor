@page "/conta"
@rendermode InteractiveServer
@using GistmCompass.Application.Abstractions
@inject ICurrentUserAccessor CurrentUser
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Conta — GISTM Compass</PageTitle>

<h1>Conta</h1>

@if (CurrentUser.User is null)
{
    <p><a href="login">Entrar</a></p>
}
else
{
    <p><strong>@CurrentUser.User.Name</strong> (@CurrentUser.User.Email)</p>
    <p>Papel: @CurrentUser.User.Role</p>
    <form method="post" action="/account/logout" data-enhance="false">
        <button type="submit" class="btn btn-secondary">Sair</button>
    </form>
}
