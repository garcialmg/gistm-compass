# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# prisma / sqlite
/prisma/dev.db
/prisma/dev.db-journal
# backups/cópias do banco (dados reais de cliente) — nunca versionar
/prisma/*.db
/prisma/*.db-*
/prisma/*.bak*

# uploads (documentos enviados pelo usuário)
/uploads

# saída do smoke test (scripts/smoke-test.mjs)
/scripts/screenshots*

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts de carga específicos de cliente (contêm caminhos locais, e-mail e
# credencial em texto) — dados de cliente, fora do repo do produto
/scripts/import-metalkol-rsf.mjs
/scripts/import-metalkol-conformidade.mjs
/scripts/seed-metalkol-gap-analysis.mjs

# logs de execução local
/dev-out.log
/dev-err.log
/import-conformidade.log
