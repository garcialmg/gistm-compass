@page "/conta"
@rendermode InteractiveServer
@using GistmCompass.Application.Abstractions
@using GistmCompass.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject ICurrentUserAccessor CurrentUser
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Conta — GISTM Compass</PageTitle>

<h1>Conta</h1>

@if (CurrentUser.User is null)
{
    <p><a href="login">Entrar</a></p>
}
else
{
    <p><strong>@CurrentUser.User.Name</strong> (@CurrentUser.User.Email)</p>
    <p>Papel: @CurrentUser.User.Role</p>
    <button class="btn btn-secondary" @onclick="Logout">Sair</button>
}

@code {
    private async Task Logout()
    {
        await SignInManager.SignOutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
